##== Environment
NODE_ENV=development

##== Application
APP_NAME="pbl-mail-service"
APP_PORT=3001
APP_DEBUG=false
APP_LOG_LEVEL=debug
APP_LOG_SERVICE=console

##== Public URL of pbl-api (used to build links such as email verification)
API_PUBLIC_URL=http://localhost:3000

##== Resend (resend.com) — real API key required, no local capture substitute.
##== Sign up at resend.com, verify a sending domain (or use their onboarding
##== test domain), grab an API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
RESEND_FROM_NAME=pbl-api

##== Upstash QStash — verifies that incoming /tasks/* requests genuinely
##== came from QStash (not a forged request). Signing keys are in the
##== Upstash console under QStash → your instance. QSTASH_DESTINATION_URL
##== must be this service's own full public URL to the endpoint (the exact
##== URL QStash was told to POST to) — has no local capture substitute,
##== same as RESEND_API_KEY above; use a tunnel (e.g. ngrok) if you need a
##== real QStash message to reach a local instance rather than curling the
##== endpoint directly.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_DESTINATION_URL=http://localhost:3001/tasks/email-verification

##== Observe (observe.nestjs.com) — same project as pbl-api, shared app key/secret
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
